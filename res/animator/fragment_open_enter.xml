<?xml version="1.0" encoding="utf-8"?>
<set android:interpolator="@interpolator/mtrl_fast_out_slow_in"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <set android:interpolator="@interpolator/mtrl_fast_out_slow_in" android:ordering="sequentially">
        <objectAnimator android:interpolator="@interpolator/mtrl_fast_out_slow_in" android:duration="75" android:valueFrom="0.0" android:valueTo="0.0" android:propertyName="alpha" />
        <objectAnimator android:interpolator="@interpolator/mtrl_fast_out_slow_in" android:duration="75" android:valueFrom="0.0" android:valueTo="1.0" android:propertyName="alpha" />
    </set>
    <objectAnimator android:interpolator="@interpolator/mtrl_fast_out_slow_in" android:duration="450" android:valueFrom="0.85" android:valueTo="1.0" android:propertyName="scaleX" />
    <objectAnimator android:interpolator="@interpolator/mtrl_fast_out_slow_in" android:duration="450" android:valueFrom="0.85" android:valueTo="1.0" android:propertyName="scaleY" />
</set>