    <set android:ordering="sequentially" android:interpolator="@interpolator/mtrl_fast_out_slow_in">
        <objectAnimator android:duration="75" android:valueFrom="0.0" android:valueTo="0.0" android:propertyName="alpha"  android:interpolator="@interpolator/mtrl_fast_out_slow_in" />
        <objectAnimator android:duration="75" android:valueFrom="0.0" android:valueTo="1.0" android:propertyName="alpha"  android:interpolator="@interpolator/mtrl_fast_out_slow_in" />
    </set>
    <objectAnimator android:duration="450" android:valueFrom="0.85" android:valueTo="1.0" android:propertyName="scaleX"  android:interpolator="@interpolator/mtrl_fast_out_slow_in" />
    <objectAnimator android:duration="450" android:valueFrom="0.85" android:valueTo="1.0" android:propertyName="scaleY"  android:interpolator="@interpolator/mtrl_fast_out_slow_in" />
</set>