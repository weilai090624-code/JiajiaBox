<?xml version="1.0" encoding="utf-8"?>
<set
  xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@interpolator/mtrl_fast_out_slow_in">
    <selector>
        <item android:state_enabled="true" android:state_hovered="true">
            <set android:interpolator="@interpolator/mtrl_fast_out_slow_in">
                <objectAnimator android:duration="@integer/m3_btn_anim_duration_ms" android:valueTo="@dimen/m3_btn_translation_z_hovered" android:valueType="floatType" android:propertyName="translationZ"  android:interpolator="@interpolator/mtrl_fast_out_slow_in" />
                <objectAnimator android:duration="0" android:valueTo="@dimen/m3_btn_elevation" android:valueType="floatType" android:propertyName="elevation"  android:interpolator="@interpolator/mtrl_fast_out_slow_in" />
            </set>
        </item>
        <item android:state_enabled="true">
            <set android:interpolator="@interpolator/mtrl_fast_out_slow_in">
                <objectAnimator android:duration="@integer/m3_btn_anim_duration_ms" android:valueTo="@dimen/m3_btn_translation_z_base" android:valueType="floatType" android:propertyName="translationZ" android:startDelay="@integer/m3_btn_anim_delay_ms"  android:interpolator="@interpolator/mtrl_fast_out_slow_in" />
                <objectAnimator android:duration="0" android:valueTo="@dimen/m3_btn_elevation" android:valueType="floatType" android:propertyName="elevation"  android:interpolator="@interpolator/mtrl_fast_out_slow_in" />
            </set>
        </item>
        <item>
            <set android:interpolator="@interpolator/mtrl_fast_out_slow_in">
                <objectAnimator android:duration="0" android:valueTo="@dimen/m3_btn_disabled_translation_z" android:valueType="floatType" android:propertyName="translationZ"  android:interpolator="@interpolator/mtrl_fast_out_slow_in" />
                <objectAnimator android:duration="0" android:valueTo="@dimen/m3_btn_disabled_elevation" android:valueType="floatType" android:propertyName="elevation"  android:interpolator="@interpolator/mtrl_fast_out_slow_in" />
            </set>
        </item>
    </selector>
</set>